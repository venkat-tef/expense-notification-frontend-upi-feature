rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /members/{memberId} {
      allow read: if request.auth != null;

      // Only admins can create/update/delete member profiles.
      // Works because new members are stored with their UID as the document ID,
      // so we can look up the caller's own role directly.
      allow create, delete: if request.auth != null &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';

      // UPI Settlement: admins can update anything (name, role, isPaymentApprover, etc.);
      // any member may additionally self-service-update ONLY their own `upiId` field —
      // nobody else knows their UPI ID, so this doesn't need to go through an admin.
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.uid == memberId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upiId']))
      );

      match /fcmTokens/{tokenId} {
        // Only the owning member can register/remove their own device's push token.
        allow read, write: if request.auth != null && request.auth.uid == memberId;
      }
    }

    match /announcements/{id} {
      allow read: if request.auth != null;
      // Only admins can create announcements — the Cloud Function fans it out to everyone.
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    // UPI Settlement: any signed-in member can read/create/move a payment to
    // "payment_pending_confirmation" (i.e. mark themselves as having paid), but only the
    // assigned payment approver can write status: 'settled' — enforced server-side, not
    // just hidden in the UI, since confirming receipt of money is the one action that
    // actually matters to get right.
    match /settlement_payments/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.resource.data.status != 'settled' ||
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.isPaymentApprover == true
      );
      allow delete: if false;
    }

    // Unchanged — all other collections (water_records, cooking_records, expenses, etc.)
    // keep working exactly as before.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{id} {
  allow read: if request.auth != null;
  allow create: if request.auth != null;
  // Anyone can mark as read (adds their own uid to readBy) — but not rewrite title/body/etc.
  allow update: if request.auth != null &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
  allow delete: if false;
}
  }
}